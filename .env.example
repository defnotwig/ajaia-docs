# Environment Configuration for Ajaia Docs
# SQLite Database is used locally (ajaia-docs.db in root)

# Auth Cookie Session Secret (Any random 32-character string)
SESSION_SECRET=supersecret-session-key-at-least-32-characters-long

# Ollama Cloud API Key - optional. When present, AI Assist uses Ollama first.
OLLAMA_API_KEY=

# Optional: override the Ollama-compatible base URL. Defaults to ollama.com.
# Examples: https://ollama.com, http://localhost:11434
OLLAMA_BASE_URL=

# Optional: override the Ollama model. Defaults to gpt-oss:20b.
# Examples: gpt-oss:20b, qwen3, llama3.1
OLLAMA_MODEL=

# OpenRouter API Key (Optional) - failover provider for AI features.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model. Defaults to google/gemini-2.5-flash:free.
# Examples: google/gemini-2.5-flash:free, google/gemini-2.0-flash-exp:free, nvidia/llama-3.1-nemotron-70b-instruct:free
OPENROUTER_MODEL=
